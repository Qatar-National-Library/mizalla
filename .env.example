# ==============================================================================
# Mizalla Environment Configuration Sample (.env.example)
# Copy this file to .env and replace placeholder values with your real credentials.
# ==============================================================================

# Session & Security
SESSION_COOKIE_SECURE=false
SECRET_KEY=replace-with-a-secure-random-secret-key-at-least-32-chars

# External Integrations
JIRA_BASE_URL=https://jira.example.org/
SENDGRID_API_KEY=SG.your-sendgrid-api-key-here

# GOWA Process Lifecycle Auto-Management (optional: true/false, default: false)
MANAGE_GOWA=true
GOWA_EXECUTABLE=/gowa/gowa.exe
GOWA_PORT=3333
GOWA_MCP_BASE_URL=http://127.0.0.1:${GOWA_PORT}

# Azure Computer Vision Service
MS_VISION_KEY=your-azure-computer-vision-key
MS_VISION_ENDPOINT=https://your-vision-resource.cognitiveservices.azure.com/

# Azure Speech Service
MS_SPEECH_KEY=your-azure-speech-key
MS_SPEECH_ENDPOINT=https://your-region.api.cognitive.microsoft.com/
MS_REGION=qatarcentral

# Azure OpenAI Service
AZURE_OPENAI_ENDPOINT=https://your-azure-openai-resource.cognitiveservices.azure.com
AZURE_OPENAI_KEY=your-azure-openai-api-key
AZURE_OPENAI_DEPLOYMENT_NAME=o4-mini
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Pingram SMS Service
PINGRAM_REGION_CODE=us
PINGRAM_API_KEY=your-pingram-api-key

# Cloudflare Stream Video Upload Service
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_API_KEY=your-cloudflare-api-token
CLOUDFLARE_ENDPOINT=https://api.cloudflare.com/client/v4

# Google Analytics API Credentials File (relative path or absolute path to JSON service account key)
GOOGLE_ANALYTICS_APIKEY_JSON=apikey_GoogleAnalytics.json
